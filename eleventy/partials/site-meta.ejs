<% const _resolvedTitle = title || site.title; %>
<title><%= title && title !== site.title ? `${title} - ${site.title}` : site.title %></title>
<meta name="author" content="CyberChitta">
<% if (pageDescription) { %>
<meta name="description" content="<%= pageDescription %>">
<% } %>
<% if (markdownPath) { %>
<link rel="alternate" type="text/markdown" href="<%= markdownPath %>">
<% } %>
<%# The RSS alternate points at the consumer's OWN origin, so only a
    consumer that builds feed.xml may advertise it (site.feed); a
    feed-less sub-site would otherwise link to a 404 on every page.
    Same gate as site.markdownMirror above. %>
<% if (site.feed) { %>
<link rel="alternate" type="application/rss+xml" title="<%= site.title %> RSS Feed" href="<%= site.url %>/feed.xml">
<% } %>
<%# Self-referencing canonical. `site.url` is the consumer's own origin for
    the current build context (see eleventy/site-url.js), so a preview
    canonicalises to itself, not to production — pair non-production deploys
    with X-Robots-Tag: noindex rather than a cross-host canonical. %>
<link rel="canonical" href="<%= site.url + page.url %>">
<!-- Open Graph / Facebook -->
<meta property="og:type" content="<%= ogT || 'website' %>">
<meta property="og:url" content="<%= site.url + page.url %>">
<meta property="og:title" content="<%= _resolvedTitle %>">
<% if (pageDescription) { %>
<meta property="og:description" content="<%= pageDescription %>">
<% } %>
<% if (featuredImage) { %>
<meta property="og:image" content="<%= absUrl(ogImage) %>">
<% } %>
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="<%= site.url + page.url %>">
<meta property="twitter:title" content="<%= _resolvedTitle %>">
<% if (pageDescription) { %>
<meta property="twitter:description" content="<%= pageDescription %>">
<% } %>
<% if (featuredImage) { %>
<meta property="twitter:image" content="<%= absUrl(twitterImage) %>">
<% } %>
<link rel="icon" type="image/svg+xml" href="<%= sg.logoSvgUrl %>" sizes="any">
<% if (featuredImage) { %>
<link rel="preload" as="image" href="<%= featuredImage %>">
<% } %>
<!-- Structured Data -->
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "<%= ogT === 'article' ? 'Article' : 'WebPage' %>",
    "headline": "<%= _resolvedTitle %>",
    "description": "<%= pageDescription %>",
    "url": "<%= site.url + page.url %>"
    <% if (publishedAt) { %>,
    "datePublished": "<%= publishedAt %>"
    <% } %>
    <% if (updatedAt) { %>,
    "dateModified": "<%= updatedAt %>"
    <% } %>,
    "author": [{
      "@type": "Organization",
      "name": "CyberChitta",
      "url": "<%= site.url %>"
    }]
  }
</script>
