<%
// Hero — the page's featured image, full-width inside the max-w-3xl container.
// The frame is square on mobile and 16:9 from md up (.cc-hero-frame).
// Locals:
//   featuredImage — image URL; nothing renders without it
//   imageCredit   — HTML for the ⓘ attribution card; also the alt text
//   imageCaption  — optional caption under the image
//   title         — alt-text fallback when there is no credit
// Per-image metadata comes from site.images: width, height, and heroFocus —
// a CSS <position> naming the point the crop keeps. A square hero loses its
// top and bottom thirds on desktop only. Defaults to the image centre.
%>
<% if (featuredImage) {
const imageMetadata = site.images.find(img => img.url === featuredImage) || {};
%>
<figure class="cc-hero">
  <div class="cc-container">
    <div class="cc-hero-inner">
      <div class="cc-hero-frame">
        <img src="<%= featuredImage %>" alt="<%= imageCredit ? helpers.stripHtml(imageCredit) : 'Featured image for ' + title %>"<% if (imageMetadata.heroFocus) { %> style="object-position: <%= imageMetadata.heroFocus %>"<% } %> width="<%= imageMetadata.width %>" height="<%= imageMetadata.height %>" fetchpriority="high" decoding="async">
      </div>
      <% if (imageCredit) { %>
      <details class="cc-hero-attr">
        <summary aria-label="Image attribution"><span class="icon icon-info" style="width:0.95rem;height:0.95rem"></span></summary>
        <div class="cc-hero-attr-card"><%- imageCredit %></div>
      </details>
      <% } %>
    </div>
    <% if (imageCaption) { %>
    <figcaption class="mt-2 text-sm text-base-content/70 italic">
      <%= imageCaption %>
    </figcaption>
    <% } %>
  </div>
</figure>
<% } %>
