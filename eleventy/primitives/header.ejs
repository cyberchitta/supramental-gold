<% const _origin = (typeof mainSiteUrl !== 'undefined' && mainSiteUrl) ? mainSiteUrl : ''; -%>
<% if (typeof brandLogoUrl === 'undefined' || !brandLogoUrl) throw new Error('primitives/header: brandLogoUrl is required (pass sg.logoSvgUrl)'); -%>
<% const _logo = brandLogoUrl; -%>
<nav class="flex items-center justify-between py-4" aria-label="Main Navigation">
  <a href="<%= _origin %>/" class="flex items-center">
    <div class="w-12 h-12 overflow-hidden rounded-full mr-3">
      <img src="<%= _logo %>" alt="CyberChitta Logo" class="w-full h-full object-cover" decoding="async" width="48" height="48">
    </div>
    <span class="logo-text text-3xl font-typewriter flex items-center">CyberChitta</span>
  </a>
</nav>
