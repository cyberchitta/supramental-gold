<%
// Grouped article list — the production listing surface of www.cyberchitta.cc.
// Locals:
//   articles       — [{ url, title, description, group, publishedAt,
//                       updatedAt?, currentAt?, form?, version?, readingTime?,
//                       writers?, showrunner?, external?, thread?, threadPart?,
//                       threadCount?, pinned? }]
//                    form — 'fixed' (default) | 'serial' | 'living'; see
//                    the sort-key and byline notes below. `version` is a
//                    living article's current version, carried on the
//                    updates[] entry that produced it; absent until its
//                    first revision, when the byline is a plain date.
//                    `pinned` — keeps the piece among its shelf's visible rows
//                    under a cap even when it would fold; see the cap note below.
//   featuredImages — { [articleUrl]: { url, thumbnailZoom?, thumbnailFocus? } } (optional)
//                    thumbnailZoom  — scale factor, zooms about thumbnailFocus
//                    thumbnailFocus — CSS <position> ('35% 20%', 'center top');
//                                     the point of the hero the 80x80 crop keeps
//                                     centred. Defaults to the image centre.
//   getAuthorImage — (tag) => avatar url, for the showrunner info-button
//   groupOrder     — group keys in precedence order (optional)
//   groupNames     — { [groupKey]: display name } (optional)
//   shelfCap       — rows shown per shelf before the rest fold into a
//                    "k more" expander, chosen thread-first (optional;
//                    default: no cap)
//   threadHref     — where a thread eyebrow links (optional)
const GROUP_ORDER = (typeof groupOrder !== 'undefined' && groupOrder) ||
  ['essays', 'research', 'tools', 'practice', 'bts', 'reference'];
const GROUP_NAMES = (typeof groupNames !== 'undefined' && groupNames) || {
  essays: 'Essays',
  research: 'Research',
  tools: 'Tools',
  practice: 'Practice',
  bts: 'Behind the scenes',
  reference: 'Reference',
};
// Shelves that sit below the recency-ordered ones whatever their dates. A
// reference piece is consulted, not followed, so its freshness is no reason to
// put it above the latest essay.
const LAST_GROUPS = ['reference'];
const SHELF_CAP = (typeof shelfCap !== 'undefined' && shelfCap) || Infinity;
const THREAD_HREF = (typeof threadHref !== 'undefined' && threadHref) || '/shala.html#the-threads';
const featImgs = (typeof featuredImages !== 'undefined' && featuredImages) || {};

// Group articles
const grouped = {};
GROUP_ORDER.forEach(g => { grouped[g] = []; });
articles.forEach(article => {
  const g = article.group || 'bts';
  if (!grouped[g]) grouped[g] = [];
  grouped[g].push(article);
});

// Sort articles within each group: reverse-chronological by `currentAt` — the
// date the article last became worth opening. For a `fixed` article that is
// publishedAt (errata must not float an old essay); for a `serial` or a
// `living` document it is the newest update, which is the whole point of both.
// The indexer derives it; fall back to publishedAt for entries baked before it
// existed, and to 0 for entries with no date at all so they sort last.
const sortKey = (a) => {
  const d = a.currentAt || a.publishedAt;
  return d ? new Date(d).valueOf() : 0;
};
Object.keys(grouped).forEach(g => {
  grouped[g].sort((a, b) => sortKey(b) - sortKey(a));
});

// Sort groups by the most recent article within each group, then append the
// LAST_GROUPS. Walk every key in `grouped`, not GROUP_ORDER: a group missing
// from the order must still render, not vanish from the page.
const nonEmpty = Object.keys(grouped).filter(g => grouped[g].length > 0);
const sortedGroups = [
  ...nonEmpty.filter(g => !LAST_GROUPS.includes(g))
    .sort((a, b) => sortKey(grouped[b][0]) - sortKey(grouped[a][0])),
  ...LAST_GROUPS.filter(g => nonEmpty.includes(g)),
];

// Cap: a shelf over SHELF_CAP shows SHELF_CAP pieces and folds the rest into a
// <details> expander. Selection is thread-first, so one busy thread cannot fill
// the shelf: the newest piece of each distinct thread (an unthreaded piece is
// its own thread), then the remaining slots by recency. A pinned piece takes a
// slot when it would otherwise fold, displacing the lowest-priority pick — the
// last recency fill, else the oldest thread-first pick. Whatever selected them,
// visible rows render in date order like the folded ones; selection decides
// whether a piece shows, not where. One pin per shelf.
function splitShelf(items) {
  const pins = items.filter(a => a.pinned);
  if (pins.length > 1) {
    throw new Error(`article-list: more than one pinned piece in shelf "${items[0].group}": ${pins.map(a => a.url).join(', ')}`);
  }
  if (items.length <= SHELF_CAP) return { visible: items, folded: [] };
  const seen = new Set();
  const threadFirst = items.filter(a => {
    const key = a.thread || a.url;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  }).slice(0, SHELF_CAP);
  const fill = items.filter(a => !threadFirst.includes(a)).slice(0, SHELF_CAP - threadFirst.length);
  const picks = [...threadFirst, ...fill];  // priority order: the last is the first to give way
  if (pins.length && !picks.includes(pins[0])) picks[picks.length - 1] = pins[0];
  return {
    visible: items.filter(a => picks.includes(a)),
    folded: items.filter(a => !picks.includes(a)),
  };
}

// Thumbnail crop: object-position picks which part of the hero the square keeps,
// transform-origin pins the zoom to that same point so the two compose instead
// of fighting. Both default to the image centre — an unannotated hero renders
// exactly as before.
function thumbStyle(featImg) {
  const parts = [];
  if (featImg.thumbnailFocus) {
    parts.push(`object-position: ${featImg.thumbnailFocus}`);
  }
  if (featImg.thumbnailZoom) {
    parts.push(`transform: scale(${featImg.thumbnailZoom})`);
    if (featImg.thumbnailFocus) parts.push(`transform-origin: ${featImg.thumbnailFocus}`);
  }
  return parts.join('; ');
}
%>
<div class="article-list">
  <% sortedGroups.forEach((groupKey, groupIdx) => { %>
  <section class="article-group<%= groupIdx > 0 ? ' mt-14' : '' %>">
    <h2 class="group-header"><%= GROUP_NAMES[groupKey] || groupKey %></h2>
    <%_ const { visible, folded } = splitShelf(grouped[groupKey]); _%>
    <%_ const renderRow = (article) => { %>
    <% const featImg = featImgs[article.url]; %>
    <% const writers = sgHelpers.bylineWriters(article.writers); %>
    <article class="mb-4 pb-4 border-b border-base-300 last:border-b-0 last:mb-0 flow-root">
      <% if (featImg) { %>
      <a href="<%= article.url %>" class="float-left mr-4 mb-2 block w-20 h-20 overflow-hidden rounded" aria-hidden="true" tabindex="-1">
        <img src="<%= featImg.url %>" alt="" class="w-full h-full object-cover"<% if (thumbStyle(featImg)) { %> style="<%= thumbStyle(featImg) %>"<% } %> loading="lazy" decoding="async" width="80" height="80">
      </a>
      <% } %>
      <% if (article.thread) { %>
      <div class="thread-eyebrow">
        <a href="<%= THREAD_HREF %>"><%= article.thread %> · <%= article.threadPart %> of <%= article.threadCount %></a>
      </div>
      <% } %>
      <h3 class="text-xl font-bold mb-1 mt-0!">
        <a href="<%= article.url %>" class="link"><%= article.title %></a>
      </h3>
      <p class="text-base-content/70 mb-2 text-sm"><%= article.description %></p>
      <% if (!article.external || writers.all.length > 0 || article.showrunner) { %>
      <div class="byline mb-0 clear-left">
        <span class="byline-writers"><%= writers.text %></span><% if (article.showrunner || writers.overflow) { %><details class="byline-info dropdown dropdown-top dropdown-end"><summary class="btn btn-ghost btn-circle btn-xs list-none text-[var(--color-link)] hover:text-[var(--color-link-hover)]" aria-label="<%= writers.overflow ? 'Credits' : 'Showrunner' %>"><span class="icon icon-info" style="width:1rem;height:1rem"></span></summary><div class="dropdown-content <%= writers.overflow ? 'w-max min-w-36' : 'w-36' %> px-3 py-2 shadow rounded-box bg-base-200 text-base-content"><div class="whitespace-nowrap"><% if (article.showrunner) { %><div class="text-xs text-base-content/70 mb-1">Showrunner</div><div class="flex items-center gap-2"><img src="<%= getAuthorImage(article.showrunner) %>" alt="Showrunner" class="w-6 h-6 rounded-full flex-shrink-0" loading="lazy" decoding="async" width="24" height="24"><span class="text-xs text-[var(--color-gold)]"><%= article.showrunner %></span></div><% } %><% if (writers.overflow) { %><div class="text-xs text-base-content/70 mb-1<%= article.showrunner ? ' mt-2' : '' %>">Writers</div><% writers.all.forEach(w => { %><div class="text-xs text-[var(--color-gold)]"><%= w %></div><% }) %><% } %></div></div></details><% } %><% if (article.publishedAt) { %><% if (writers.all.length > 0) { %><br class="sm:hidden"><span class="byline-sep sm:inline hidden"> · </span><% } %><%- sgHelpers.bylineDates({ form: article.form, publishedAt: article.publishedAt, latestAt: article.updatedAt, version: article.version }) %><% if (article.readingTime) { %> <span class="byline-sep">·</span> <span class="byline-meta"><%= article.readingTime %> min</span><% } %><% } %>
      </div>
      <% } %>
    </article>
    <%_ } _%>
    <%_ visible.forEach(renderRow) _%>
    <%_ if (folded.length) { _%>
    <details>
      <summary class="cursor-pointer text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)]"><%= folded.length %> more <%= GROUP_NAMES[groupKey] || groupKey %> <%= folded.length === 1 ? 'piece' : 'pieces' %></summary>
      <div class="mt-4">
      <% folded.forEach(renderRow) %>
      </div>
    </details>
    <% } %>
  </section>
  <% }) %>
</div>
